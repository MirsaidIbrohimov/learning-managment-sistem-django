{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Faqat lokal asosiy oyna: oyna boshqaruvi va ilova buyruqlari. Sayt oynalariga (web, w*) hech narsa ochilmagan.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "allow-has-session",
    "allow-login",
    "allow-auth-start",
    "allow-auth-poll",
    "allow-auth-cancel",
    "allow-logout",
    "allow-api",
    "allow-open-web",
    "allow-open-external"
  ]
}
