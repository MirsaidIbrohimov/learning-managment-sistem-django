{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ITC Academy",
  "mainBinaryName": "ITC Academy",
  "version": "2.2.0",
  "identifier": "uz.itcacademy.lms",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: itcmedia: http://itcmedia.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "frame-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "publisher": "IT Creative Academy",
    "homepage": "https://itc-academy.uz",
    "copyright": "© IT Creative Academy",
    "category": "Education",
    "shortDescription": "ITC Academy öquv platformasi",
    "longDescription": "IT Creative Academy LMS uçun Windows ilovasi: kurslar, reyting, coin dökon, kutubxona, natijalar va sertifikatlar — alohida desktop interfeysda.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "ITC Academy",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}