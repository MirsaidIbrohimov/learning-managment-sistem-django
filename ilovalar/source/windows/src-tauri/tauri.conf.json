{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ITC Academy",
  "mainBinaryName": "ITC Academy",
  "version": "1.0.0",
  "identifier": "uz.itcacademy.lms",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "IT Creative Academy",
    "homepage": "https://itc-academy.uz",
    "copyright": "© IT Creative Academy",
    "category": "Education",
    "shortDescription": "ITC Academy o‘quv platformasi",
    "longDescription": "IT Creative Academy LMS (https://itc-academy.uz) uchun Windows ilovasi: darslar, vazifalar, testlar va sertifikatlar.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "ITC Academy",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
