# ═══ Passenger sozlamalari ═══
PassengerAppRoot /home/itcreati/itc-academy.uz
PassengerPython /home/itcreati/itc-academy.uz/.venv/bin/python

# Passenger versiya ma'lumotini yashirish
PassengerShowVersionInHeader off

# ═══ Xavfsizlik ═══
<IfModule mod_headers.c>
    # X-Powered-By va Server yashirish (barcha joylarda)
    Header always unset X-Powered-By
    Header unset X-Powered-By
    Header always unset Server
    Header unset Server

    # Agar Passenger header qolsa — bo'sh qiymatga almashtirish
    Header always edit X-Powered-By ".*" ""
</IfModule>
