# Nusxa oling: cp .env.example .env
# Bu fayl faqat kalit nomlari uchun namuna. Hech qachon real qiymat yozmang.

# ---- Django core ----
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=kjdhbfvdfvdfv79dfv687dfy6v87dfyv87dfvy8df7vtyd8f7vtdf687vtrdf75vrd6ef54e53def54v
DJANGO_SECRET_KEY=kjdhbfvdfvdfv79dfv687dfy6v87dfyv87dfvy8df7vtyd8f7vtdf687vtrdf75vrd6ef54e53def54v
# Productionda majburiy: False
DEBUG=False
# Vergul bilan ajratilgan domenlar. Productionda '*' ishlatmang.
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000
# Admin panel manzilini standart 'admin/' dan boshqasiga o'zgartiring
ADMIN_URL=admin/

# Reverse proxy (nginx/cPanel) orqasida ishlayotgan bo'lsa True.
# True bo'lganda TRUSTED_PROXY_COUNT ta oxirgi X-Forwarded-For qiymati ishonchli deb olinadi.
USE_X_FORWARDED_FOR=False
TRUSTED_PROXY_COUNT=1

# HTTPS. Local HTTP development uchun False qoldiring.
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0
CSRF_TRUSTED_ORIGINS=

# ---- Tashqi servislar ----
# ---- Email: parolni avtomatik tiklash ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_TIMEOUT=15

OPENAI_API_KEY=
YOUTUBE_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_GROUP_CHAT_ID=
# Telegram webhook uchun maxfiy token (setWebhook + X-Telegram-Bot-Api-Secret-Token)
# Faqat A-Z a-z 0-9 _ - belgilari, 1-256 uzunlik.
TELEGRAM_WEBHOOK_SECRET=
# /telegram/health/ endpointini himoyalash uchun
TELEGRAM_HEALTH_TOKEN=

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ---- To'lov tizimlari ----
PAYME_ID=
PAYME_KEY=
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# ---- Tezcheck to'lovlari ----
# API kalitini va webhook imzo sirini hech qachon frontendga chiqarmang.
TEZCHECK_API_BASE_URL=https://api.tezcheck.uz/api/merchant/v1
TEZCHECK_API_TOKEN=
TEZCHECK_CASH_DESK_CODE=
TEZCHECK_WEBHOOK_SECRET=
TEZCHECK_RETURN_URL=
TEZCHECK_SIGN_REQUESTS=true
TEZCHECK_LATE_GRACE_DAYS=5
# Merchant tomonidan tasdiqlangan chegaralar (so‘m); taxminiy qiymat kiritmang.
TEZCHECK_COIN_MIN_SOM=1000
TEZCHECK_COIN_MAX_SOM=1000000

# ---- Search engine canonical site origin ----
SEO_CANONICAL_ORIGIN=https://itc-academy.uz

# Daily database backup; existing python-dotenv loader reads these values.
# Optional override. Empty uses the existing TELEGRAM_BOT_TOKEN.
BACKUP_TELEGRAM_BOT_TOKEN=
BACKUP_TELEGRAM_CHAT_ID=-1003968166001
# Absolute private directory OUTSIDE media/static and the public document root.
BACKUP_DIR=/home/itcreati/private_backups
BACKUP_RETENTION_DAYS=7
BACKUP_MAX_DISK_MB=1024
BACKUP_MIN_FREE_MB=100
BACKUP_HTTP_TIMEOUT=120
BACKUP_DUMP_TIMEOUT=1800
BACKUP_PG_DUMP=pg_dump
BACKUP_MYSQLDUMP=mysqldump

# Optional shared cache: provision/test Redis before enabling.
USE_REDIS_CACHE=false
# Shared disk cache for landing/dashboard data when Redis is disabled.
# Must be a private writable directory OUTSIDE public_html, media and static.
USE_FILE_CACHE=true
# Empty defaults to ~/.cache/lms-<project-specific-hash>
FILE_CACHE_DIR=
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
REDIS_SESSION_URL=redis://127.0.0.1:6379/2
REDIS_SESSIONS_ENABLED=false
CACHE_KEY_PREFIX=lms-v1
# Public data only, never session/CSRF HTML. 0 disables this cache.
LANDING_CACHE_SECONDS=60
# Set false only after scheduling single cron workers (see performance guide).
RUN_INPROCESS_WORKERS=true
RUN_STARTUP_TEMPLATE_REPAIR=true
