<!DOCTYPE html>
<html lang="uz" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    
    <title><%= title %></title>
    <meta name="description" content="<%= description %>">
    <meta name="keywords" content="<%= keywords %>">
    <meta name="author" content="IT Creative Academy">
    <meta name="robots" content="index, follow">
    <meta name="language" content="Uzbek">
    <meta name="revisit-after" content="3 days">
    
    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="<%= url %>">
    <meta property="og:title" content="<%= title %>">
    <meta property="og:description" content="<%= description %>">
    <meta property="og:image" content="<%= url %>/images/og-image.png">
    <meta property="og:locale" content="uz_UZ">
    <meta property="og:site_name" content="IT Creative Academy">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= title %>">
    <meta name="twitter:description" content="<%= description %>">
    <meta name="twitter:image" content="<%= url %>/images/og-image.png">
    
    <link rel="canonical" href="<%= url %>">
    <link rel="icon" type="image/x-icon" href="/images/favicon.ico">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- Main CSS -->
    <link rel="stylesheet" href="/css/style.css">

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "IT Creative Academy",
        "url": "<%= url %>",
        "logo": "<%= url %>/images/logo.png",
        "description": "<%= description %>",
        "address": {
            "@type": "PostalAddress",
            "addressLocality": "Qarshi",
            "addressRegion": "Qashqadaryo",
            "addressCountry": "UZ"
        },
        "contactPoint": {
            "@type": "ContactPoint",
            "telephone": "+998-91-123-45-67",
            "contactType": "customer service"
        },
        "sameAs": [
            "https://t.me/itcreative",
            "https://instagram.com/itcreative",
            "https://youtube.com/@ITCreative"
        ]
    }
    </script>
</head>
<body>
    <!-- PRELOADER -->
    <div class="preloader">
        <div class="preloader-content">
            <div class="preloader-logo">IT Creative</div>
            <div class="preloader-bar"></div>
        </div>
    </div>

    <!-- PARTICLES -->
    <div class="particles-container"></div>

    <!-- NAVBAR -->
    <nav class="navbar" role="navigation" aria-label="Asosiy navigatsiya">
        <div class="nav-container">
            <a href="/" class="nav-logo" aria-label="IT Creative Academy - Bosh sahifa">
                <img src="/images/logo.png" alt="IT Creative Academy logotipi" width="42" height="42">
                <span>IT Creative</span>
            </a>
            
            <ul class="nav-links">
                <li><a href="#home">Bosh sahifa</a></li>
                <li><a href="#about">Biz haqimizda</a></li>
                <li><a href="#courses">Kurslar</a></li>
                <li><a href="#advantages">Afzalliklar</a></li>
                <li><a href="#contact">Aloqa</a></li>
                <li><a href="/login" class="nav-btn"><i class="fas fa-sign-in-alt"></i> Kirish</a></li>
            </ul>

            <button class="hamburger" aria-label="Menyu" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </div>
    </nav>

    <!-- HERO -->
    <section class="hero" id="home">
        <canvas id="hero-canvas" aria-hidden="true"></canvas>
        <div class="hero-overlay"></div>
        
        <div class="floating-shapes" aria-hidden="true">
            <div class="shape shape-1"></div>
            <div class="shape shape-2"></div>
            <div class="shape shape-3"></div>
        </div>

        <div class="hero-content">
            <div class="hero-text">
                <div class="hero-badge">
                    <span class="dot"></span>
                    Ro'yxatdan o'tish ochiq
                </div>
                
                <h1 class="hero-title">
                    <span class="gradient-text">IT Creative</span>
                    <span class="line-2">Academy — Kelajak <span class="typing-text">Dasturlash</span> da</span>
                </h1>
                
                <p class="hero-description">
                    Zamonaviy IT ta'lim markazi. Dasturlash, Web Development, Mobile va boshqa 
                    yo'nalishlar bo'yicha professional ta'lim oling. Tajribali ustozlar va real loyihalar bilan o'rganing.
                </p>

                <div class="hero-buttons">
                    <a href="/register" class="btn-primary">
                        <i class="fas fa-rocket"></i> Ro'yxatdan o'tish
                    </a>
                    <a href="#courses" class="btn-secondary">
                        <i class="fas fa-play-circle"></i> Kurslarni ko'rish
                    </a>
                </div>

                <div class="hero-stats">
                    <div class="stat-item">
                        <div class="stat-number" data-count="500" data-suffix="+">0</div>
                        <div class="stat-label">O'quvchilar</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number" data-count="15" data-suffix="+">0</div>
                        <div class="stat-label">Kurslar</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-number" data-count="98" data-suffix="%">0</div>
                        <div class="stat-label">Mamnuniyat</div>
                    </div>
                </div>
            </div>

            <div class="hero-3d">
                <div id="hero-model" aria-hidden="true"></div>
            </div>
        </div>
    </section>

    <!-- ABOUT -->
    <section class="section" id="about">
        <div class="section-container">
            <div class="section-header reveal">
                <span class="section-subtitle">
                    <i class="fas fa-info-circle"></i> Biz haqimizda
                </span>
                <h2 class="section-title">
                    Nima uchun <span class="gradient-text">IT Creative</span>?
                </h2>
                <p class="section-desc">
                    Biz nafaqat o'rgatamiz — biz kelajak IT mutaxassislarini tayyorlaymiz
                </p>
            </div>

            <div class="about-grid">
                <div class="about-3d reveal">
                    <div id="about-model" aria-hidden="true"></div>
                </div>
                
                <div class="about-features">
                    <div class="about-feature reveal">
                        <div class="feature-icon blue">
                            <i class="fas fa-laptop-code"></i>
                        </div>
                        <div class="feature-text">
                            <h4>Amaliy ta'lim</h4>
                            <p>Har bir darsda real loyihalar ustida ishlaysiz. Nazariya + Amaliyot = Natija!</p>
                        </div>
                    </div>
                    
                    <div class="about-feature reveal">
                        <div class="feature-icon purple">
                            <i class="fas fa-users"></i>
                        </div>
                        <div class="feature-text">
                            <h4>Tajribali ustozlar</h4>
                            <p>IT sohasida 5+ yillik tajribaga ega mutaxassislar dars beradi</p>
                        </div>
                    </div>
                    
                    <div class="about-feature reveal">
                        <div class="feature-icon green">
                            <i class="fas fa-certificate"></i>
                        </div>
                        <div class="feature-text">
                            <h4>Sertifikat</h4>
                            <p>Kursni muvaffaqiyatli tugatganlarga rasmiy sertifikat beriladi</p>
                        </div>
                    </div>
                    
                    <div class="about-feature reveal">
                        <div class="feature-icon orange">
                            <i class="fas fa-briefcase"></i>
                        </div>
                        <div class="feature-text">
                            <h4>Ishga joylashish</h4>
                            <p>Eng yaxshi o'quvchilarimizga ishga joylashishda yordam beramiz</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- COURSES -->
    <section class="section" id="courses" style="background: rgba(5, 5, 16, 0.5);">
        <div class="section-container">
            <div class="section-header reveal">
                <span class="section-subtitle">
                    <i class="fas fa-graduation-cap"></i> Kurslarimiz
                </span>
                <h2 class="section-title">
                    <span class="gradient-text">Professional</span> kurslar
                </h2>
                <p class="section-desc">
                    Zamonaviy texnologiyalar bo'yicha eng so'nggi kurslarni kashf eting
                </p>
            </div>

            <div class="courses-grid">
                <article class="course-card reveal">
                    <div class="course-icon web"><i class="fas fa-globe"></i></div>
                    <h3>Web Development</h3>
                    <p>HTML, CSS, JavaScript, React, Node.js — to'liq fullstack dasturchi bo'ling</p>
                    <div class="course-tags">
                        <span class="course-tag">HTML/CSS</span>
                        <span class="course-tag">JavaScript</span>
                        <span class="course-tag">React</span>
                    </div>
                </article>

                <article class="course-card reveal">
                    <div class="course-icon mobile"><i class="fas fa-mobile-alt"></i></div>
                    <h3>Mobile Development</h3>
                    <p>Flutter va React Native orqali iOS va Android ilovalar yarating</p>
                    <div class="course-tags">
                        <span class="course-tag">Flutter</span>
                        <span class="course-tag">Dart</span>
                        <span class="course-tag">React Native</span>
                    </div>
                </article>

                <article class="course-card reveal">
                    <div class="course-icon python"><i class="fab fa-python"></i></div>
                    <h3>Python dasturlash</h3>
                    <p>Python asoslari, Django, Flask va ma'lumotlar tahlili</p>
                    <div class="course-tags">
                        <span class="course-tag">Python</span>
                        <span class="course-tag">Django</span>
                        <span class="course-tag">Data Science</span>
                    </div>
                </article>

                <article class="course-card reveal">
                    <div class="course-icon design"><i class="fas fa-paint-brush"></i></div>
                    <h3>UI/UX Dizayn</h3>
                    <p>Figma, Adobe XD orqali zamonaviy va foydalanuvchiga qulay dizaynlar yarating</p>
                    <div class="course-tags">
                        <span class="course-tag">Figma</span>
                        <span class="course-tag">Adobe XD</span>
                        <span class="course-tag">Prototyping</span>
                    </div>
                </article>

                <article class="course-card reveal">
                    <div class="course-icon data"><i class="fas fa-desktop"></i></div>
                    <h3>Kompyuter savodxonligi</h3>
                    <p>Office dasturlari, Internet xavfsizligi va asosiy kompyuter ko'nikmalarini o'rganing</p>
                    <div class="course-tags">
                        <span class="course-tag">MS Office</span>
                        <span class="course-tag">Internet</span>
                        <span class="course-tag">Asoslar</span>
                    </div>
                </article>

                <article class="course-card reveal">
                    <div class="course-icon ai"><i class="fas fa-robot"></i></div>
                    <h3>Sun'iy Intellekt</h3>
                    <p>AI, Machine Learning va Deep Learning asoslari va amaliy loyihalar</p>
                    <div class="course-tags">
                        <span class="course-tag">AI/ML</span>
                        <span class="course-tag">TensorFlow</span>
                        <span class="course-tag">NLP</span>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- ADVANTAGES -->
    <section class="section" id="advantages">
        <div class="section-container">
            <div class="section-header reveal">
                <span class="section-subtitle">
                    <i class="fas fa-star"></i> Afzalliklar
                </span>
                <h2 class="section-title">
                    Nima uchun <span class="gradient-text">bizni tanlashadi</span>?
                </h2>
                <p class="section-desc">
                    IT Creative Academy ni boshqa o'quv markazlardan ajratib turadigan xususiyatlar
                </p>
            </div>

            <div class="advantages-grid">
                <div class="advantage-card reveal">
                    <span class="advantage-icon">🎓</span>
                    <h4>Sifatli ta'lim</h4>
                    <p>Xalqaro standartlarga mos keladigan ta'lim dasturlari va zamonaviy o'quv materiallari</p>
                </div>
                
                <div class="advantage-card reveal">
                    <span class="advantage-icon">💻</span>
                    <h4>Zamonaviy platforma</h4>
                    <p>Online va offline ta'lim imkoniyati. O'z shaxsiy kabinetingiz va progress tracking</p>
                </div>
                
                <div class="advantage-card reveal">
                    <span class="advantage-icon">🏆</span>
                    <h4>Gamifikatsiya</h4>
                    <p>Coin tizimi, reyting jadvali va musobaqalar orqali o'rganish jarayonini qiziqarli qiling</p>
                </div>
                
                <div class="advantage-card reveal">
                    <span class="advantage-icon">🤖</span>
                    <h4>AI Yordamchi</h4>
                    <p>Sun'iy intellekt yordamchisi bilan 24/7 savol-javob va vazifalarni tekshirish</p>
                </div>
            </div>
        </div>
    </section>

    <!-- TESTIMONIALS -->
    <section class="section" style="background: rgba(5, 5, 16, 0.5);">
        <div class="section-container">
            <div class="section-header reveal">
                <span class="section-subtitle">
                    <i class="fas fa-quote-left"></i> Fikrlar
                </span>
                <h2 class="section-title">
                    <span class="gradient-text">O'quvchilarimiz</span> nima deydi?
                </h2>
            </div>

            <div class="testimonials-wrapper">
                <div class="testimonial-card reveal">
                    <div class="testimonial-stars">★★★★★</div>
                    <p class="testimonial-text">
                        "IT Creative da Web Development kursini tugatdim. Hozir freelancer sifatida ishlayapman va 
                        oylik daromadim ancha yaxshi. Ustozlarga rahmat!"
                    </p>
                    <div class="testimonial-author">
                        <div class="author-avatar av1">A</div>
                        <div class="author-info">
                            <h5>Abdulloh M.</h5>
                            <span>Web Developer</span>
                        </div>
                    </div>
                </div>

                <div class="testimonial-card reveal">
                    <div class="testimonial-stars">★★★★★</div>
                    <p class="testimonial-text">
                        "Python kursini o'qib, Data Science sohasida ish topdim. Amaliy mashg'ulotlar juda foydali bo'ldi. 
                        Hamma narsani real loyihalarda o'rgandim."
                    </p>
                    <div class="testimonial-author">
                        <div class="author-avatar av2">S</div>
                        <div class="author-info">
                            <h5>Sardor T.</h5>
                            <span>Data Analyst</span>
                        </div>
                    </div>
                </div>

                <div class="testimonial-card reveal">
                    <div class="testimonial-stars">★★★★★</div>
                    <p class="testimonial-text">
                        "Gamifikatsiya tizimi juda zo'r! Coin yig'ish va reyting kurashish o'qishni juda qiziqarli qildi. 
                        Platform ham juda qulay va zamonaviy."
                    </p>
                    <div class="testimonial-author">
                        <div class="author-avatar av3">M</div>
                        <div class="author-info">
                            <h5>Madina K.</h5>
                            <span>Frontend Developer</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CONTACT / APPLICATION -->
    <section class="section" id="contact">
        <div class="section-container">
            <div class="section-header reveal">
                <span class="section-subtitle">
                    <i class="fas fa-envelope"></i> Bog'lanish
                </span>
                <h2 class="section-title">
                    <span class="gradient-text">Ariza qoldiring</span>
                </h2>
                <p class="section-desc">
                    Kursga yozilish yoki qo'shimcha ma'lumot olish uchun ariza qoldiring
                </p>
            </div>

            <div class="contact-grid">
                <div class="contact-info reveal">
                    <div class="contact-item">
                        <div class="contact-icon"><i class="fas fa-map-marker-alt"></i></div>
                        <div class="contact-details">
                            <h4>Manzil</h4>
                            <p>Qarshi shahri, Qashqadaryo viloyati, O'zbekiston</p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon"><i class="fas fa-phone-alt"></i></div>
                        <div class="contact-details">
                            <h4>Telefon</h4>
                            <p><a href="tel:+998911234567">+998 91 123 45 67</a></p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon"><i class="fab fa-telegram-plane"></i></div>
                        <div class="contact-details">
                            <h4>Telegram</h4>
                            <p><a href="https://t.me/itcreative" target="_blank" rel="noopener">@itcreative</a></p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon"><i class="fab fa-instagram"></i></div>
                        <div class="contact-details">
                            <h4>Instagram</h4>
                            <p><a href="https://instagram.com/itcreative" target="_blank" rel="noopener">@itcreative</a></p>
                        </div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-icon"><i class="fas fa-clock"></i></div>
                        <div class="contact-details">
                            <h4>Ish vaqti</h4>
                            <p>Dushanba - Shanba: 09:00 - 18:00</p>
                        </div>
                    </div>
                </div>

                <div class="contact-form-wrapper reveal">
                    <h3>📝 Ariza qoldirish</h3>
                    <p class="form-desc">Ma'lumotlaringizni qoldiring, biz siz bilan bog'lanamiz</p>
                    
                    <form id="applicationForm">
                        <div class="form-row">
                            <div class="form-group">
                                <label for="firstName">Ism *</label>
                                <input type="text" id="firstName" name="firstName" placeholder="Ismingiz" required>
                            </div>
                            <div class="form-group">
                                <label for="lastName">Familiya *</label>
                                <input type="text" id="lastName" name="lastName" placeholder="Familiyangiz" required>
                            </div>
                        </div>

                        <div class="form-group">
                            <label for="phone">Telefon raqam *</label>
                            <input type="tel" id="phone" name="phone" placeholder="+998 XX XXX XX XX" required>
                        </div>

                        <div class="form-group">
                            <label for="courseInterest">Qiziqtirgan yo'nalish</label>
                            <select id="courseInterest" name="courseInterest">
                                <option value="">Tanlang...</option>
                                <option value="Web Development">Web Development</option>
                                <option value="Mobile Development">Mobile Development</option>
                                <option value="Python">Python dasturlash</option>
                                <option value="UI/UX Design">UI/UX Dizayn</option>
                                <option value="Kompyuter savodxonligi">Kompyuter savodxonligi</option>
                                <option value="AI/ML">Sun'iy Intellekt</option>
                                <option value="Boshqa">Boshqa</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="message">Qo'shimcha xabar</label>
                            <textarea id="message" name="message" rows="3" placeholder="Savolingiz yoki izohingiz..."></textarea>
                        </div>

                        <button type="submit" class="form-submit">
                            <i class="fas fa-paper-plane"></i> Ariza yuborish
                        </button>

                        <div class="form-message"></div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
        <div class="section-container">
            <div class="cta-content reveal">
                <h2>Kelajagingizni <span class="gradient-text">bugun</span> boshlang!</h2>
                <p>IT Creative Academy bilan professional IT mutaxassis bo'ling</p>
                <div class="hero-buttons" style="justify-content: center;">
                    <a href="/register" class="btn-primary">
                        <i class="fas fa-user-plus"></i> Hoziroq ro'yxatdan o'ting
                    </a>
                    <a href="/ariza" class="btn-secondary">
                        <i class="fas fa-file-alt"></i> Ariza qoldirish
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- FOOTER -->
    <footer class="footer" role="contentinfo">
        <div class="footer-grid">
            <div class="footer-brand">
                <h3>🚀 <span>IT Creative</span> Academy</h3>
                <p>
                    Zamonaviy IT ta'lim markazi. Dasturlash, dizayn va boshqa IT yo'nalishlar 
                    bo'yicha sifatli ta'lim. Kelajagingizni biz bilan boshlang!
                </p>
                <div class="social-links">
                    <a href="https://t.me/itcreative" class="social-link" target="_blank" rel="noopener" aria-label="Telegram">
                        <i class="fab fa-telegram-plane"></i>
                    </a>
                    <a href="https://instagram.com/itcreative" class="social-link" target="_blank" rel="noopener" aria-label="Instagram">
                        <i class="fab fa-instagram"></i>
                    </a>
                    <a href="https://youtube.com/@ITCreative" class="social-link" target="_blank" rel="noopener" aria-label="YouTube">
                        <i class="fab fa-youtube"></i>
                    </a>
                    <a href="https://github.com/itcreative" class="social-link" target="_blank" rel="noopener" aria-label="GitHub">
                        <i class="fab fa-github"></i>
                    </a>
                </div>
            </div>

            <div class="footer-col">
                <h4>Kurslar</h4>
                <ul>
                    <li><a href="#courses">Web Development</a></li>
                    <li><a href="#courses">Mobile Development</a></li>
                    <li><a href="#courses">Python</a></li>
                    <li><a href="#courses">UI/UX Dizayn</a></li>
                    <li><a href="#courses">Sun'iy Intellekt</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Havolalar</h4>
                <ul>
                    <li><a href="#about">Biz haqimizda</a></li>
                    <li><a href="#contact">Aloqa</a></li>
                    <li><a href="/login">Kirish</a></li>
                    <li><a href="/register">Ro'yxatdan o'tish</a></li>
                    <li><a href="/ariza">Ariza qoldirish</a></li>
                </ul>
            </div>

            <div class="footer-col">
                <h4>Bog'lanish</h4>
                <ul>
                    <li><a href="tel:+998911234567">+998 91 123 45 67</a></li>
                    <li><a href="mailto:info@itc-academy.uz">info@itc-academy.uz</a></li>
                    <li><a href="#">Qarshi, O'zbekiston</a></li>
                </ul>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; 2024-2026 <a href="/">IT Creative Academy</a>. Barcha huquqlar himoyalangan.</p>
            <p>Suyunov Husan tomonidan ishlab chiqilgan ❤️</p>
        </div>
    </footer>

    <!-- BACK TO TOP -->
    <button class="back-to-top" aria-label="Tepaga qaytish">
        <i class="fas fa-chevron-up"></i>
    </button>

    <!-- SCRIPTS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
