<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: 'Segoe UI', sans-serif;
            background: #0a0a1a; 
            color: #fff; 
            display: flex; 
            align-items: center; 
            justify-content: center; 
            height: 100vh;
            text-align: center;
        }
        h1 { font-size: 8rem; background: linear-gradient(135deg, #00d4ff, #7b2ff7); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        p { font-size: 1.5rem; margin: 1rem 0; color: #8892b0; }
        a { color: #00d4ff; text-decoration: none; font-size: 1.2rem; border: 2px solid #00d4ff; padding: 12px 30px; border-radius: 50px; transition: all 0.3s; display: inline-block; margin-top: 1rem; }
        a:hover { background: #00d4ff; color: #0a0a1a; }
    </style>
</head>
<body>
    <div>
        <h1>404</h1>
        <p>Sahifa topilmadi</p>
        <a href="/">🏠 Bosh sahifaga qaytish</a>
    </div>
</body>
</html>
